@startuml
title Vapor Repository Migration Model

skinparam backgroundColor transparent
skinparam shadowing false
skinparam packageStyle rectangle

package "CURRENT" {
    package "Vapor-Root" as OLD_CLIENT {
        rectangle Vapor
        rectangle "Vapor-SDK" as OLD_SDK
        rectangle "Vapor-Launcher" as OLD_LAUNCHER
        rectangle "Vapor-Installer" as OLD_INSTALLER
        rectangle "Vapor-Entrypoint" as OLD_ENTRY
        rectangle "Vapor-Shell" as OLD_SHELL
        rectangle "Vapor-Examples" as EXAMPLES
    }

    package "Vapor-Server-Root" as OLD_PLATFORM {
        rectangle "Vapor-Homepage-Server" as HOMEPAGE
        rectangle "Vapor-Docs-Server" as DOCS
        rectangle "Vapor-Identity-Server" as IDENTITY
        rectangle "Vapor-Diagnostics-Server" as DIAGNOSTICS
        rectangle "Vapor-Registry-Server" as REGISTRY_SERVER
    }

    rectangle "Vapor-Registry\n(overlapping authority)" as OLD_REGISTRY
}

package "TARGET" {
    package "Vapor-Client" as NEW_CLIENT {
        rectangle "Vapor\nCore + Client projections" as NEW_VAPOR
        rectangle "Vapor-Examples" as NEW_EXAMPLES
    }

    package "Vapor-Platform-Server" as NEW_PLATFORM {
        rectangle "Homepage Service" as NEW_HOMEPAGE
        rectangle "Docs Service" as NEW_DOCS
        rectangle "Identity Service" as NEW_IDENTITY
        rectangle "Diagnostics Service" as NEW_DIAGNOSTICS
        rectangle "Registry Service" as NEW_REGISTRY
    }

    rectangle "Vapor-Documentation\nfuture authored docs source" as DOCUMENTATION
    rectangle "Vapor-App-Server\nfuture" as APP_SERVER
}

OLD_CLIENT --> NEW_CLIENT : rename
OLD_PLATFORM --> NEW_PLATFORM : rename

Vapor --> NEW_VAPOR : keep / expand
EXAMPLES --> NEW_EXAMPLES : keep

OLD_SDK --> NEW_VAPOR : migrate useful source / design
OLD_LAUNCHER --> NEW_VAPOR : consolidate
OLD_INSTALLER --> NEW_VAPOR : consolidate
OLD_ENTRY --> NEW_VAPOR : consolidate
OLD_SHELL --> NEW_VAPOR : reinterpret / consolidate

HOMEPAGE --> NEW_HOMEPAGE : keep
DOCS --> NEW_DOCS : keep
IDENTITY --> NEW_IDENTITY : keep
DIAGNOSTICS --> NEW_DIAGNOSTICS : keep
REGISTRY_SERVER --> NEW_REGISTRY : keep

OLD_REGISTRY ..> NEW_REGISTRY : REVIEW\nretire or repurpose

note bottom of NEW_VAPOR
Binaries may remain distinct.
Git repositories need not.
end note

note bottom of NEW_PLATFORM
Independent service boundaries
remain meaningful.
end note

note bottom of DOCUMENTATION
Extract only after the
topology migration stabilizes.
end note

@enduml